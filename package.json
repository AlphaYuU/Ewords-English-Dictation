{
  "name": "dictation-app",
  "version": "1.0.2",
  "description": "Desktop dictation practice app.",
  "author": "Ewords Dictation",
  "private": true,
  "type": "module",
  "main": "apps/desktop/dist-electron/main/main.js",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "dev:web": "corepack pnpm --filter @dictation/desktop dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "start:desktop": "corepack pnpm build && electron apps/desktop/dist-electron/main/main.js",
    "build": "corepack pnpm --filter @dictation/desktop build",
    "prepare:package": "node scripts/prepare-package-assets.mjs",
    "package:win": "corepack pnpm prepare:package && corepack pnpm build && node node_modules/electron-builder/cli.js --config electron-builder.yml --win nsis portable",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "tts:setup": "node scripts/setup-piper.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@dictation/data-access": "workspace:*",
    "@dictation/domain": "workspace:*",
    "@dictation/import-export": "workspace:*",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jiti": "^2.6.1",
    "lucide-react": "^0.561.0",
    "prettier": "^3.7.4",
    "rcedit": "^5.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3",
    "zustand": "^5.0.12"
  }
}
